{
  "id": "orbit",
  "name": "Orbit",
  "shortName": "Orbit",
  "version": "0.37",
  "author": "onisY",
  "description": "Lightweight Sun-Earth-Moon clock for Bangle.js 2 with North/South views, offline Japan locations, selectable Earth rendering, daily solar-event buzzes, lunar illumination/eclipses, battery display, swipe screenshots, optional calendar launch and BLE reset. No GPS.",
  "icon": "app.png",
  "type": "clock",
  "tags": "clock,science,astronomy,moon",
  "supports": [
    "BANGLEJS2"
  ],
  "readme": "README.md",
  "allow_emulator": true,
  "storage": [
    {
      "name": "orbit.app.js",
      "url": "app.wrapper.js"
    },
    {
      "name": "orbit.core.js",
      "url": "app.min.js"
    },
    {
      "name": "orbit.settings.js",
      "url": "settings.min.js"
    },
    {
      "name": "orbitloc",
      "url": "locations.js"
    },
    {
      "name": "orbit.img",
      "url": "app-icon.js",
      "evaluate": true
    }
  ],
  "data": [
    {
      "name": "orbit.json"
    },
    {
      "name": "orbitshot.json"
    }
  ]
}
