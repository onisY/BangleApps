{
  "id": "orbit",
  "name": "Orbit",
  "shortName": "Orbit",
  "version": "0.25",
  "author": "onisY",
  "description": "Sun-Earth-Moon clock for Bangle.js 2 with time navigation, offline Japan locations, selectable Earth rendering, lunar illumination/eclipses, battery display and swipe screenshots. No GPS.",
  "icon": "app.png",
  "type": "clock",
  "tags": "clock,science,astronomy,moon",
  "supports": [
    "BANGLEJS2"
  ],
  "readme": "README.md",
  "allow_emulator": true,
  "storage": [
    {
      "name": "orbit.app.js",
      "url": "app.js"
    },
    {
      "name": "orbit.settings.js",
      "url": "settings.js"
    },
    {
      "name": "orbitloc",
      "url": "locations.js"
    },
    {
      "name": "orbit.img",
      "url": "app-icon.js",
      "evaluate": true
    }
  ],
  "data": [
    {
      "name": "orbit.json"
    },
    {
      "name": "orbitshot.json"
    }
  ]
}
