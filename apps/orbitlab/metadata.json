{
  "id": "orbitlab",
  "name": "tenkyu Rest Lab",
  "shortName": "Rest Lab",
  "version": "0.10",
  "author": "onisY",
  "description": "Record acceleration, case temperature, pulse confidence and tenkyu wear decisions for local graphing.",
  "icon": "app.png",
  "tags": "tools",
  "supports": [
    "BANGLEJS2"
  ],
  "readme": "README.md",
  "storage": [
    {
      "name": "orbitlab.app.js",
      "url": "app.js"
    },
    {
      "name": "orbitlab.rest",
      "url": "rest.js"
    },
    {
      "name": "orbitlab.img",
      "url": "app-icon.js",
      "evaluate": true
    }
  ],
  "data": [
    {
      "wildcard": "orbitlab-*.csv",
      "storageFile": true
    }
  ]
}
