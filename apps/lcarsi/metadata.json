{
  "id": "lcarsi",
  "name": "LCARSi",
  "shortName": "LCARSi",
  "icon": "app.png",
  "version": "0.01",
  "readme": "README.md",
  "supports": [
    "BANGLEJS2"
  ],
  "description": "LCARS Clock adapted for iPhone/iOS using the official iOS Integration and Weather apps.",
  "type": "clock",
  "tags": "clock,ios,apple,weather",
  "author": "peerdavid; iOS adaptation by onisY",
  "dependencies": {
    "ios": "app",
    "weather": "app",
    "messages": "module",
    "mylocation": "app",
    "sched": "module"
  },
  "allow_emulator": true,
  "storage": [
    {
      "name": "lcarsi.app.js",
      "url": "app.js"
    },
    {
      "name": "lcarsi.img",
      "url": "icon.js",
      "evaluate": true
    },
    {
      "name": "lcarsi.settings.js",
      "url": "settings.js"
    }
  ],
  "data": [
    {
      "name": "lcarsi.setting.json"
    }
  ]
}
